# ThreatLens configuration
# Copy to .env and edit

# Server port (default: 8080)
PORT=8080

# Secret key for Flask sessions (change in production)
SECRET_KEY=change-me-to-a-random-string

# NVD API key (optional, increases rate limit from 5 to 50 req/30s)
# Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Slack webhook URL for advisory notifications (optional)
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Data directory (default: ./data)
THREATLENS_DATA_DIR=./data
